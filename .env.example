# =============================================================================
# Universal AI Library Assistant - Configuration Template
# 100% Free, Offline-First, and No Paid APIs Required
# =============================================================================

# Server Binding
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1

# Ollama Endpoint Configuration
# For local desktop development:
OLLAMA_BASE_URL=http://localhost:11434

# For hybrid cloud deployment (pointing to a local Ollama instance via Cloudflare Tunnel / ngrok):
# OLLAMA_BASE_URL=https://your-ollama-tunnel.trycloudflare.com

# For cloud VPS / container deployment with Ollama co-located:
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model Name (Llama 3.2 3B is lightweight and fast)
OLLAMA_MODEL=llama3.2:3b
